[Unit]
Description=Houzzkit first-boot web interface
Requires=htool-account.socket
After=htool-account.socket

[Service]
User=htool
Group=htool
ExecStart=/usr/local/bin/htool web
StateDirectory=htool-web
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
